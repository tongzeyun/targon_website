# 官网区域默认语言；每个服务器都支持 /zh 和 /en。
SITE_DEFAULT_LOCALE=zh

# Web / Worker / db:migrate 共用。填写实际值到 .env.local；不要提交真实配置。
# NODE_ENV=production 时，CLI 按 Next 规则加载生产环境文件。
DATABASE_URL=
JWT_SECRET=
# 反向代理修改 Host 时填写浏览器实际 Origin，多项以逗号分隔。
# AUTH_TRUSTED_ORIGIN=https://app.example.com
# CORS_ORIGINS=https://authorized-client.example.com
# AUTH_MAX_ACTIVE_SESSIONS=10

# 上传文件和生成文档。Web 与 Worker 必须连接同一存储。
FILE_STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/stored-files
# FILE_STORAGE_DRIVER=oss
# OSS_REGION=cn-shanghai
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# OSS_INTERNAL_ENDPOINT=
# OSS_FORCE_PATH_STYLE=false

# AI 提供商，保留现有中文业务数据和提示词。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=
# DEEPSEEK_QUOTA_DAILY_SUCCESS_LIMIT=50
# DEEPSEEK_QUOTA_MAX_CONCURRENT=2
# DEEPSEEK_QUOTA_LEASE_SECONDS=600

# 讯飞录音文件转写（标准版 LFASR）。
# IFLYTEK_LFASR_APP_ID=
# IFLYTEK_LFASR_SECRET_KEY=
# IFLYTEK_LFASR_BASE_URL=https://raasr.xfyun.cn/v2/api
# IFLYTEK_LFASR_TIMEOUT_MS=1800000
# IFLYTEK_LFASR_POLL_INTERVAL_MS=5000
# IFLYTEK_SPEECH_QUOTA_DAILY_SUCCESS_LIMIT=20
# IFLYTEK_SPEECH_QUOTA_MAX_CONCURRENT=2
# IFLYTEK_SPEECH_QUOTA_LEASE_SECONDS=1800

# 讯飞文档转换 / OCR。
# IFLYTEK_DOCUMENT_APP_ID=
# IFLYTEK_DOCUMENT_API_SECRET=
# IFLYTEK_DOCUMENT_BASE_URL=https://iocr.xfyun.cn/ocrzdq/v1/pdfOcr
