# IFLYTEK_DOCUMENT_QUOTA_MAX_CONCURRENT=2
# IFLYTEK_DOCUMENT_QUOTA_LEASE_SECONDS=1800

# 独立 Worker；HTTP 触发入口仍需要 JOB_WORKER_KEY。
# JOB_WORKER_ID=worker-1
# JOB_WORKER_POLL_MS=5000
# JOB_STALE_TIMEOUT_MS=1800000
# JOB_WORKER_KEY=
# STORED_FILE_CLEANUP_INTERVAL_MS=21600000
# AUTH_SESSION_CLEANUP_INTERVAL_MS=21600000

# ingest API 的配置；Python 当前只采集、提取和打印，不自动调用 ingest。
